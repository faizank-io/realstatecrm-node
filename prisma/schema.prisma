generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  AGENCY_OWNER
  OFFICE_MANAGER
  PROPERTY_MANAGER
  AGENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum AgencyStatus {
  ACTIVE
  PAST_DUE
  SUSPENDED
  TRIAL
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum ItemStatus {
  ACTIVE
  INACTIVE
}

enum ListingType {
  SALE
  RENT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ClientType {
  BUYER
  SELLER
  LANDLORD
  TENANT
  INVESTOR
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  VIEWING
  NEGOTIATING
  WON
  LOST
}

enum DealStage {
  OFFER_RECEIVED
  NEGOTIATION
  AGREEMENT
  PAYMENT
  CLOSED
}

enum ViewingStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum EntityType {
  PROPERTY
  CLIENT
  DEAL
  VIEWING
}

// ─── MODELS ──────────────────────────────────────────────────────────────────

model SubscriptionPlan {
  id                    String   @id @default(uuid())
  name                  String   @unique
  description           String?  @db.Text

  monthlyPrice          Float    @default(0.0)
  yearlyPrice           Float    @default(0.0)

  maxSeats              Int      @default(5)
  maxListings           Int      @default(150)
  maxStorageGB          Float    @default(20.0)

  // Feature Flags
  hasDealsCommission   Boolean  @default(false)
  hasCustomRoles       Boolean  @default(false)
  hasPortalSyndication Boolean  @default(false)
  hasWhiteLabel        Boolean  @default(false)
  hasApiAccess         Boolean  @default(false)
  hasAuditLogSSO       Boolean  @default(false)
  hasAdvancedAnalytics Boolean  @default(false)

  // Stripe Integration
  stripeProductId        String?
  stripePriceIdMonthly  String?
  stripePriceIdYearly   String?

  agencies              Agency[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("subscription_plans")
}

model Agency {
  id                 String           @id @default(uuid())
  name               String
  slug               String           @unique
  city               String           @default("Karachi")
  ownerName          String?
  status             AgencyStatus     @default(TRIAL)
  billingCycle       BillingCycle     @default(MONTHLY)
  seatsCount         Int              @default(1)
  storageUsedGB      Float            @default(0.0)
  renewsAt           DateTime?
  mrr                Float            @default(0.0)

  subscriptionPlanId String?
  subscriptionPlan   SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])

  users              User[]
  properties         Property[]
  clients            Client[]
  deals              Deal[]
  viewings           Viewing[]
  documents          Document[]

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@map("agencies")
}

model User {
  id           String     @id @default(uuid())
  agencyId     String?
  agency       Agency?    @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  name         String
  email        String     @unique
  password     String
  role         Role       @default(AGENT)
  status       UserStatus @default(ACTIVE)
  lastSeen     DateTime?
  avatar       String?
  refreshToken String?    @db.Text

  createdProperties   Property[] @relation("PropertyCreator")
  assignedProperties  Property[] @relation("PropertyAssignee")
  createdClients      Client[]   @relation("ClientCreator")
  assignedClients     Client[]   @relation("ClientAssignee")
  assignedDeals       Deal[]     @relation("DealAssignee")
  assignedViewings    Viewing[]  @relation("ViewingAssignee")
  uploadedDocuments   Document[] @relation("DocumentUploader")
  activities          ActivityLog[]

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([agencyId])
  @@index([email])
  @@map("users")
}

model SystemSetting {
  id                    String   @id @default("default-settings")
  trialLengthDays       Int      @default(14)
  defaultPlanName       String   @default("Starter")
  dataRegion            String   @default("eu-north-1")
  uploadCapMB           Int      @default(25)

  // AWS S3 Settings & Keys
  s3Enabled             Boolean  @default(true)
  awsAccessKeyId        String?  @db.Text
  awsSecretAccessKey    String?  @db.Text
  awsRegion             String   @default("eu-north-1")
  awsBucket             String   @default("freehold-crm-storage")

  // Stripe Settings & Keys
  stripeEnabled         Boolean  @default(true)
  stripePublicKey       String?  @db.Text
  stripeSecretKey       String?  @db.Text
  stripeWebhookSecret   String?  @db.Text

  // Amazon SES Email Settings & Keys
  sesEnabled            Boolean  @default(true)
  sesAccessKeyId        String?  @db.Text
  sesSecretAccessKey    String?  @db.Text
  sesRegion             String   @default("eu-north-1")
  sesSenderEmail        String   @default("no-reply@freehold.app")

  isMaintenanceMode     Boolean  @default(false)

  updatedAt             DateTime @updatedAt

  @@map("system_settings")
}


model PropertyType {
  id         String             @id @default(uuid())
  name       String             @unique // e.g. Residential, Commercial
  slug       String             @unique
  status     ItemStatus         @default(ACTIVE) // ACTIVE or INACTIVE
  categories PropertyCategory[]
  properties Property[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  @@map("property_types")
}

model PropertyCategory {
  id             String       @id @default(uuid())
  name           String       // e.g. Apartment, House, Plot
  slug           String       @unique
  status         ItemStatus   @default(ACTIVE)
  
  propertyTypeId String
  propertyType   PropertyType @relation(fields: [propertyTypeId], references: [id], onDelete: Cascade)
  properties     Property[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("property_categories")
}


model ListingStatus {
  id        String   @id @default(uuid())
  name      String   @unique // e.g. Active, Sold, Off-Market
  slug      String   @unique
  colorCode String?  // e.g. #FF0000
  status    ItemStatus @default(ACTIVE)
  properties Property[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("listing_statuses")
}


model Amenity {
  id        String   @id @default(uuid())
  name      String   @unique // e.g. Swimming Pool, Gym
  slug      String   @unique
  icon      String?  
  status    ItemStatus @default(ACTIVE)
  properties PropertyAmenity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("amenities")
}

model LeadSource {
  id        String   @id @default(uuid())
  name      String   @unique // e.g. Zameen.com, Graana, Walk-in
  slug      String   @unique
  status    ItemStatus @default(ACTIVE)
  clients   Client[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lead_sources")
}

// ─── CORE MODULES ────────────────────────────────────────────────────────────

model Property {
  id              String         @id @default(uuid())
  referenceNumber String         @unique // e.g. SLS-1234 or RNT-5678
  title           String
  description     String?        @db.Text
  type            ListingType    @default(SALE) // Sale or Rent
  price           Float          @default(0.0) // Asking price or monthly rent
  listingViews    Int            @default(0)    // Page view counter
  
  // Geography
  city            String?
  area            String?        // e.g. Bahria Orchard, DHA Phase 8
  sectorReference String?        // e.g. Plot 185-A
  location        String?        // e.g. DHA Phase 8 (for list cards)
  address         String?        // Full street address
  
  // Specs
  bedrooms        Int            @default(0)
  bathrooms       Int            @default(0)
  parking         Int            @default(0)
  floors          Int            @default(1)
  size            Float          @default(0.0) // in sq ft
  builtYear       Int?
  isFurnished     Boolean        @default(false)
  
  approvalStatus  ApprovalStatus @default(PENDING)
  
  // Foreign Keys
  agencyId        String
  agency          Agency            @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  
  createdById     String
  createdBy       User              @relation("PropertyCreator", fields: [createdById], references: [id])
  
  assignedToId    String?
  assignedTo      User?             @relation("PropertyAssignee", fields: [assignedToId], references: [id])
  
  propertyTypeId  String?
  propertyType    PropertyType?     @relation(fields: [propertyTypeId], references: [id])
  
  categoryId      String?
  category        PropertyCategory? @relation(fields: [categoryId], references: [id])
  
  listingStatusId String?
  listingStatus   ListingStatus?    @relation(fields: [listingStatusId], references: [id])
  
  ownerClientId   String?
  ownerClient     Client?        @relation("PropertyOwner", fields: [ownerClientId], references: [id], onDelete: SetNull)


  // Relations
  images          PropertyImage[]
  amenities       PropertyAmenity[]
  leads           PropertyLead[]    // Clients interested in this property
  priceHistory    PriceHistory[]    // Price change log
  viewings        Viewing[]
  activities      ActivityLog[]
  deals           Deal[]            // Back-reference required by Prisma (use Deal.propertyId to query)

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("properties")
}

model PropertyImage {
  id         String   @id @default(uuid())
  url        String
  name       String?  // e.g. "Floor plan — level 1", "Elevation 2"
  isMain     Boolean  @default(false)
  sortOrder  Int      @default(0)
  
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  createdAt  DateTime @default(now())

  @@map("property_images")
}

// Tracks every price change: Listed price → Reduced → etc.
model PriceHistory {
  id         String   @id @default(uuid())
  price      Float
  note       String?  // e.g. "Listed", "Reduced"

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@map("price_history")
}

// Many-to-many: A client can be a lead for multiple properties
model PropertyLead {
  id           String     @id @default(uuid())

  propertyId   String
  property     Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  clientId     String
  client       Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt    DateTime   @default(now())

  @@unique([propertyId, clientId])
  @@map("property_leads")
}

model PropertyAmenity {
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  amenityId  String
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  
  @@id([propertyId, amenityId])
  @@map("property_amenities")
}

model Client {
  id              String         @id @default(uuid())
  referenceNumber String         @unique // e.g. CL-1024
  firstName       String
  lastName        String?
  email           String?
  phone           String?
  type            ClientType     @default(BUYER)
  stage           LeadStage      @default(NEW)
  budget          Float          @default(0.0)
  lastTouchedAt   DateTime?      // "Last Touch" column in UI

  sourceId        String?
  source          LeadSource?    @relation(fields: [sourceId], references: [id])

  agencyId        String
  agency          Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  createdById     String
  createdBy       User           @relation("ClientCreator", fields: [createdById], references: [id])

  assignedToId    String?
  assignedTo      User?          @relation("ClientAssignee", fields: [assignedToId], references: [id])

  ownedProperties Property[]     @relation("PropertyOwner")

  propertyLeads   PropertyLead[] // Properties this client is interested in
  deals           Deal[]
  viewings        Viewing[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("clients")
}

model Deal {
  id              String      @id @default(uuid())
  referenceNumber String      @unique // e.g. DL-2694
  type            ListingType @default(SALE)
  stage           DealStage   @default(OFFER_RECEIVED)
  value           Float       @default(0.0) // Deal value / asking price at time of deal

  propertyId      String?
  property        Property?   @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  clientId        String?
  client          Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)

  agencyId        String
  agency          Agency      @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  assignedToId    String?     // Agent handling the deal
  assignedTo      User?       @relation("DealAssignee", fields: [assignedToId], references: [id])

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("deals")
}

model Viewing {
  id              String         @id @default(uuid())
  startAt         DateTime
  endAt           DateTime
  status          ViewingStatus  @default(SCHEDULED)
  feedback        String?        @db.Text

  propertyId      String
  property        Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  clientId        String?
  client          Client?        @relation(fields: [clientId], references: [id], onDelete: Cascade)

  agencyId        String
  agency          Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  assignedToId    String?
  assignedTo      User?          @relation("ViewingAssignee", fields: [assignedToId], references: [id])

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("viewings")
}

model Document {
  id              String          @id @default(uuid())
  name            String
  fileType        String
  url             String
  sizeBytes       Int             @default(0)

  attachedToType  EntityType
  attachedToId    String

  agencyId        String
  agency          Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  uploadedById    String
  uploadedBy      User            @relation("DocumentUploader", fields: [uploadedById], references: [id])

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("documents")
}

model ActivityLog {
  id              String          @id @default(uuid())
  action          String

  entityType      EntityType
  entityId        String

  propertyId      String?
  property        Property?       @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  userId          String
  user            User            @relation(fields: [userId], references: [id])

  createdAt       DateTime        @default(now())

  @@map("activity_logs")
}
